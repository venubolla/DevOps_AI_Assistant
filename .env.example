# Application
APP_NAME=DevOps AI Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=devops_ai
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=replace_with_a_local_development_password

# Application database connection
DATABASE_URL=postgresql+psycopg://devops_user:replace_with_a_local_development_password@localhost:5433/devops_ai

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Evaluation and retrieval gate (threshold calibrated against the labeled set)
RAGAS_MODEL=qwen2.5:7b-instruct
JUDGE_MODEL=qwen2.5:7b-instruct
RELEVANCE_THRESHOLD=-5.0
